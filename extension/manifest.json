{
  "manifest_version": 3,
  "name": "MotifJS DevTools",
  "description": "Inspect MotifJS apps: components, reactivity, performance, router, stores, services and logs.",
  "version": "0.0.0",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/active-16.png",
    "32": "icons/active-32.png",
    "48": "icons/active-48.png",
    "128": "icons/active-128.png"
  },
  "action": {
    "default_title": "MotifJS DevTools",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/idle-16.png",
      "32": "icons/idle-32.png",
      "48": "icons/idle-48.png",
      "128": "icons/idle-128.png"
    }
  },
  "devtools_page": "devtools.html",
  "background": { "service_worker": "background.js" },
  "permissions": ["scripting"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["detector.js"], "run_at": "document_start", "world": "MAIN" },
    { "matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_start" }
  ]
}
