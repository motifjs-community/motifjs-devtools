{
  "name": "@motifx-community/devtools",
  "version": "0.0.0",
  "description": "Developer tools for inspecting MotifJS (@motifx/core) apps",
  "keywords": [
    "motifjs",
    "motifx",
    "motif",
    "ui",
    "devtools"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/motifjs-community/motifjs-devtools"
  },
  "homepage": "https://motifjs.com/docs/devtools",
  "bugs": {
    "url": "https://github.com/motifjs-community/motifjs-devtools/issues"
  },
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite examples/basic",
    "build": "vite build && tsc -p tsconfig.build.json",
    "example:build": "vite build examples/basic",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint:jsx": "motif-lint",
    "check": "npm run typecheck && npm run lint:jsx && npm test && npm run build && npm run example:build",
    "prepublishOnly": "npm run check"
  },
  "peerDependencies": {
    "@motifx/core": "^1.2.0-rc.6"
  },
  "devDependencies": {
    "@motifx/compiler": "1.2.0-rc.6",
    "@motifx/core": "1.2.0-rc.6",
    "@types/node": "^24.19.1",
    "jsdom": "^30.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  }
}
